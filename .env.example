# KOSIS 공유서비스 인증키.
# 🔴 발급된 값을 **그대로** 넣는다. base64 처럼 보여도 디코드하면 안 된다 —
#    디코드한 값을 보내면 {"err":"11","errMsg":"유효하지않은 인증KEY입니다."} 가 온다(실측).
KOSIS_API_KEY=your_key_here

# 교육망·사내망 SSL 인터셉션 대응(OS 신뢰저장소 사용, 검증은 유지). 0 이면 비활성.
KOSIS_OS_TRUST=1

# ── 선택 ────────────────────────────────────────────────────────────────────
# 한 번의 도구 호출이 낼 수 있는 API 요청 수 상한(기본 120). 4만 셀 자동 분할이
# 기간을 반씩 쪼개므로 넓은 구간 × 촘촘한 주기에서 요청이 크게 늘 수 있다.
KOSIS_MAX_CALLS_PER_TOOL_CALL=120

# 호출 간격(초). 분당 200건 제한 → 0.35초면 약 171회/분.
KOSIS_THROTTLE=0.35
